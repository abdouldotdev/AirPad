// Copiez ce fichier en Config/Secrets.xcconfig et renseignez les valeurs.
// Secrets.xcconfig est ignoré par git : aucune clé ne part dans l'historique.

REVENUECAT_API_KEY =
POSTHOG_API_KEY =
// Slashes échappés : xcconfig traite « // » comme un commentaire.
POSTHOG_HOST = https:/$()/eu.i.posthog.com
